{
  "name": "masters-mind-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static learning site generated from the NUS Masters Obsidian vault",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:exams": "node build.mjs --include-exams",
    "serve": "python3 -m http.server 8080 --directory dist",
    "test:labs": "node scripts/test-labs.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "katex": "0.19.0",
    "marked": "18.0.2"
  }
}
