# Copy this file to .env (same folder) and fill it in. .env is gitignored: it never leaves this PC.

# The one password for the site (at least 8 characters; a passphrase is best).
MASTERS_PASSWORD=change-me-to-a-long-passphrase

# Port the server listens on. ngrok forwards to it: ngrok http 8080
PORT=8080

# 127.0.0.1 = only this PC (and ngrok) can connect. Use 0.0.0.0 to also allow phones on your home Wi-Fi.
HOST=127.0.0.1

# Optional: a fixed secret for signing login cookies (32+ random characters).
# Leave empty and one is generated into server/data/session.secret on first run.
SESSION_SECRET=

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# Trust X-Forwarded-For / X-Forwarded-Proto from ngrok (needed for per-IP login lockout and Secure cookies).
TRUST_PROXY=1

# Optional: where the vault lives if not ./vault/NUS Masters (e.g. your synced Obsidian folder).
# VAULT=C:\Users\you\Documents\NUS Masters
